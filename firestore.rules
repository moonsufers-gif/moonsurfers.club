rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- COLLECTION: Skater User Profiles ---
    match /users/{userId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Dynamic Skate Challenges ---
    match /challenges/{challengeId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Social Trick Clips Uploads ---
    match /trick_uploads/{uploadId} {
      allow read, write: if true;
    }

    // --- COLLECTION: District Sector Locations ---
    match /districts/{districtId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Direct Com-Link Messages ---
    match /direct_messages/{messageId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Custom Spot GPS Registrations ---
    match /custom_spots/{spotId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Server Video Synced Metadata ---
    match /video_meta/{videoId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Server Video Synced Chunks ---
    match /video_chunks/{chunkId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Server Music Synced Metadata ---
    match /music_meta/{trackId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Server Music Synced Chunks ---
    match /music_chunks/{chunkId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Basic Connection Test Sump ---
    match /test/{testId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Wawoloradio Settings & DJ Curator ---
    match /wawoloradio_settings/{settingId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Wawoloradio Playlist Tracks ---
    match /wawoloradio_tracks/{trackId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Wawoloradio Playlists ---
    match /wawoloradio_playlists/{playlistId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Real-Time Moon Phases & Lunar States ---
    match /moon_phases/{phaseId} {
      allow read, write: if true;
    }

    match /lunar_config/{configId} {
      allow read, write: if true;
    }

    // --- COLLECTION: System Configuration & Gates ---
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Outlaw Intel Feed ---
    match /outlaw_intel/{intelId} {
      allow read, write: if true;
    }

    // --- COLLECTION: Outlaw Events Feed ---
    match /outlaw_events/{eventId} {
      allow read, write: if true;
    }

    // --- CATCH-ALL RULE FOR ALL APP COLLECTIONS & SUBCOLLECTIONS ---
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

